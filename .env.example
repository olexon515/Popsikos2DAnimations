# Copy this file to `.env` and put your real key there.
# `.env` is gitignored and never leaves your machine.
#
# 1. Get a key: https://elevenlabs.io/app/settings/api-keys
# 2. cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# 3. Edit .env, then run:   python generate_voices.py
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
